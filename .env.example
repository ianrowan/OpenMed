# OpenMed Environment Variables
# Copy this file to .env.local and fill in your values

# OpenAI API Key (required)
OPENAI_API_KEY=

# Supabase Configuration (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pinecone Configuration (optional - for production)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# Chroma Configuration (optional - defaults to local)
CHROMA_HOST=http://localhost:8000

# Local LLM Configuration (optional - for Ollama)
# Set to 'true' to use Ollama instead of OpenAI
NEXT_PUBLIC_ENABLE_LOCAL_LLM=false
# Ollama API endpoint (default: http://localhost:11434/api - uses native Ollama API with tool support)
NEXT_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434/api
# Ollama model to use (e.g., llama3.2:3b, llama3.1:8b, mistral:7b)
NEXT_PUBLIC_OLLAMA_MODEL=llama3.2:3b

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

